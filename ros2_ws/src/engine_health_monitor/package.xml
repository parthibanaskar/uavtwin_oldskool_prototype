<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>engine_health_monitor</name>
  <version>0.1.0</version>
  <description>
    Engine health telemetry sampler + digital-twin bridge for a MALE UAV
    piston engine, integrating with PX4 via ROS 2 / uXRCE-DDS.
  </description>
  <maintainer email="team@example.com">Team Circuit Sentinels</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>rosidl_default_generators</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
